{
  "schemaVersion": 1,
  "namespace": "greenguard",
  "phases": [
    {"id": "controllers", "requires": ["EKS API reachable", "pinned Argo CD, Istio, KEDA and Argo Rollouts controllers and CRDs healthy"]},
