{
  "schemaVersion": 1,
  "namespace": "greenguard",
  "requiredApplications": [
    "greenguard-edge-routing",
    "greenguard-disposable-data",
    "greenguard-kafka-topics",
    "greenguard-schema-registry",
    "greenguard-pgbouncer",
    "greenguard-kafka-connect",
    "greenguard-connector-registration",
    "greenguard-opensearch",
    "greenguard-cassandra",
    "greenguard-clickhouse",
    "greenguard-live-acceptance-probes"
  ],
  "phases": [
    {
      "id": "controllers",
      "requires": [
        "EKS API reachable",
        "pinned Argo CD, Istio, KEDA and Argo Rollouts controllers and CRDs healthy"
      ]
    },
    {
      "id": "data",
      "requires": [
        "PostgreSQL/PgBouncer",
        "Kafka/Connect/schema registry",
        "RabbitMQ",
        "Redis",
        "Cassandra",
        "OpenSearch",
        "MQTT",
        "object storage",
        "OIDC issuer and JWKS over HTTPS"
      ]
    },
    {
      "id": "migrations",
      "requires": [
        "all PostgreSQL owner-role migrations applied",
        "Kafka topics and connectors registered",
        "Cassandra keyspace/schema applied",
        "OpenSearch templates/indexes applied",
        "real tenant membership seeded"
      ]
    },
    {
      "id": "applications",
      "requires": [
        "every image digest resolved",
        "every secret reference exists",
        "NetworkPolicy peers and mesh principals rendered"
      ]
    },
    {
      "id": "acceptance",
      "probes": [
        "postgres-shard-read-write-replica-freshness",
        "pgbouncer-transaction-pool",
        "kafka-produce-consume",
        "kafka-connect-connector-status",
        "schema-registry-subject-compatibility",
        "rabbitmq-publish-consume",
        "redis-tenant-cache-roundtrip",
        "cassandra-tenant-partition-roundtrip",
        "opensearch-index-search",
        "clickhouse-roundtrip",
        "mqtt-tls-auth-publish-subscribe",
        "object-storage-audit-export-roundtrip",
        "oauth-discovery-jwks",
        "tenant-membership-readback"
      ],
      "journeys": [
        "web-login",
        "api-auth",
        "tenant-isolation",
        "alert-create",
        "alert-live-update",
        "alert-ack",
        "iphone-physical-login",
        "iphone-alert-ack",
        "iphone-signout-offline",
        "telemetry-projection",
        "recovery",
        "teardown"
      ],
      "requires": [
        "all workloads Available/Ready",
        "web and iPhone OAuth/API journeys",
        "telemetry to projection and alerts",
        "ACK and live updates"
      ]
    }
  ],
