    {"id": "migrations", "requires": ["all PostgreSQL owner-role migrations applied", "Kafka topics and connectors registered", "Cassandra keyspace/schema applied", "OpenSearch templates/indexes applied", "real tenant membership seeded"]},
    {"id": "applications", "requires": ["every image digest resolved", "every secret reference exists", "NetworkPolicy peers and mesh principals rendered"]},
