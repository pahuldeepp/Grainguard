{
  "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
  "tasks.max": "1",
  "database.hostname": "postgres",
  "database.port": "5432",
  "database.user": "cdc_reader",
  "database.password": "${env:CDC_DB_PASSWORD}",
  "database.dbname": "greenguard_control",
  "topic.prefix": "greenguard_control_contacts",
  "plugin.name": "pgoutput",
  "slot.name": "greenguard_control_notification_contacts",
  "slot.drop.on.stop": "false",
  "publication.name": "greenguard_control_notification_contacts",
  "publication.autocreate.mode": "disabled",
  "table.include.list": "public.notification_contacts",
  "snapshot.mode": "initial",
  "snapshot.locking.mode": "none",
  "tombstones.on.delete": "false",
  "include.schema.changes": "false",
  "heartbeat.interval.ms": "30000",
  "heartbeat.action.query": "SELECT pg_logical_emit_message(true, 'greenguard.notification-contacts-feed', 'checkpoint')",
  "message.prefix.include.list": "greenguard\\.notification-contacts-feed",
  "value.converter": "io.confluent.connect.avro.AvroConverter",
  "value.converter.schema.registry.url": "${env:SCHEMA_REGISTRY_URL}",
  "value.converter.value.subject.name.strategy": "io.confluent.kafka.serializers.subject.TopicNameStrategy",
  "key.converter": "org.apache.kafka.connect.json.JsonConverter",
  "key.converter.schemas.enable": "false",
  "predicates": "contactsTopicPredicate,heartbeatTopicPredicate",
  "predicates.contactsTopicPredicate.type": "org.apache.kafka.connect.transforms.predicates.TopicNameMatches",
  "predicates.contactsTopicPredicate.pattern": "^greenguard_control_contacts\\.public\\.notification_contacts$",
  "predicates.heartbeatTopicPredicate.type": "org.apache.kafka.connect.transforms.predicates.TopicNameMatches",
  "predicates.heartbeatTopicPredicate.pattern": "^greenguard_control_contacts\\.message$",
  "transforms": "unwrapContacts,flattenHeartbeat,selectHeartbeatFields,castHeartbeatTime,addContractVersion,castVersion,removeContactMetadata,contactsTopic,heartbeatTopic",
  "transforms.unwrapContacts.type": "io.debezium.transforms.ExtractNewRecordState",
  "transforms.unwrapContacts.predicate": "contactsTopicPredicate",
  "transforms.unwrapContacts.delete.tombstone.handling.mode": "rewrite",
  "transforms.unwrapContacts.add.fields": "op,source.ts_ms",
  "transforms.flattenHeartbeat.type": "org.apache.kafka.connect.transforms.Flatten$Value",
  "transforms.flattenHeartbeat.predicate": "heartbeatTopicPredicate",
  "transforms.flattenHeartbeat.delimiter": "_",
  "transforms.selectHeartbeatFields.type": "org.apache.kafka.connect.transforms.ReplaceField$Value",
  "transforms.selectHeartbeatFields.predicate": "heartbeatTopicPredicate",
  "transforms.selectHeartbeatFields.include": "message_prefix,message_content,source_ts_ms",
  "transforms.selectHeartbeatFields.renames": "message_prefix:prefix,message_content:content,source_ts_ms:__source_ts_ms",
  "transforms.castHeartbeatTime.type": "org.apache.kafka.connect.transforms.Cast$Value",
  "transforms.castHeartbeatTime.predicate": "heartbeatTopicPredicate",
  "transforms.castHeartbeatTime.spec": "__source_ts_ms:string",
  "transforms.addContractVersion.type": "org.apache.kafka.connect.transforms.InsertField$Value",
  "transforms.addContractVersion.predicate": "contactsTopicPredicate",
  "transforms.addContractVersion.static.field": "schema_version",
  "transforms.addContractVersion.static.value": "1",
  "transforms.castVersion.type": "org.apache.kafka.connect.transforms.Cast$Value",
  "transforms.castVersion.predicate": "contactsTopicPredicate",
  "transforms.castVersion.spec": "version:string",
  "transforms.removeContactMetadata.type": "org.apache.kafka.connect.transforms.ReplaceField$Value",
  "transforms.removeContactMetadata.predicate": "contactsTopicPredicate",
  "transforms.removeContactMetadata.exclude": "updated_by,updated_at",
  "transforms.contactsTopic.type": "org.apache.kafka.connect.transforms.RegexRouter",
  "transforms.contactsTopic.regex": "^greenguard_control_contacts\\.public\\.notification_contacts$",
  "transforms.contactsTopic.replacement": "greenguard.notifications.contacts.cdc.v1",
  "transforms.heartbeatTopic.type": "org.apache.kafka.connect.transforms.RegexRouter",
  "transforms.heartbeatTopic.regex": "^greenguard_control_contacts\\.message$",
  "transforms.heartbeatTopic.replacement": "greenguard.notifications.contacts.heartbeat.v2"
}
