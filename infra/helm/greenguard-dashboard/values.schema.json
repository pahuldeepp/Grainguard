{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["image", "replicaCount", "rollouts", "pdb", "service", "publicOidc", "resources", "scheduling", "networkPolicy", "mesh", "observability"],
  "properties": {
    "image": {
      "type": "string",
      "pattern": "^.+@sha256:[a-f0-9]{64}$"
    },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "replicaCount": {
      "type": "integer",
      "minimum": 2
    },
    "rollouts": {
      "type": "object",
      "required": ["enabled", "analysis"],
      "properties": {
        "enabled": { "type": "boolean" },
        "analysis": {
          "type": "object",
          "required": ["prometheusAddress", "successRateQuery", "successRateThreshold", "interval", "count", "failureLimit"],
          "properties": {
            "prometheusAddress": { "type": "string" },
            "successRateQuery": { "type": "string" },
            "successRateThreshold": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
            "interval": { "type": "string", "minLength": 1 },
            "count": { "type": "integer", "minimum": 1 },
            "failureLimit": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "pdb": {
      "type": "object",
      "required": ["enabled", "minAvailable"],
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": "integer", "minimum": 1 }
      }
    },
    "service": {
      "type": "object",
      "required": ["port", "containerPort"],
      "properties": {
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "containerPort": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "publicOidc": {
      "type": "object",
      "required": ["enabled", "authority", "clientId", "tokenMode", "audience", "resource", "connectOrigins"],
      "properties": {
        "enabled": { "type": "boolean" },
        "authority": { "type": "string" },
        "clientId": { "type": "string" },
        "tokenMode": { "type": "string", "enum": ["audience", "cognito-access"] },
        "audience": { "type": "string" },
        "resource": { "type": "string" },
        "connectOrigins": { "type": "array", "items": { "type": "string", "pattern": "^https://[^/?#@]+$" }, "uniqueItems": true }
      }
    },
    "resources": {
      "type": "object",
      "required": ["requests", "limits"],
      "properties": {
        "requests": { "type": "object", "required": ["cpu", "memory"] },
        "limits": { "type": "object", "required": ["cpu", "memory"] }
      }
    },
    "scheduling": {
      "type": "object",
      "required": ["nodeSelector", "affinity", "tolerations", "topologySpreadConstraints", "priorityClassName"],
      "properties": {
        "nodeSelector": { "type": "object" },
        "affinity": { "type": "object" },
        "tolerations": { "type": "array", "items": { "type": "object" } },
        "topologySpreadConstraints": { "type": "array", "items": { "type": "object" } },
        "priorityClassName": { "type": "string" }
      }
    },
    "networkPolicy": {
      "type": "object",
      "required": ["enabled", "ingressNamespace", "ingressSelector", "egressServices"],
      "properties": {
        "enabled": { "type": "boolean", "const": true },
        "ingressNamespace": { "type": "string", "minLength": 1 },
        "ingressSelector": { "type": "object", "minProperties": 1 },
        "egressServices": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "namespace", "release", "port"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "namespace": { "type": "string" },
              "release": { "type": "string", "minLength": 1 },
              "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
            }
          }
        }
      }
    },
    "mesh": {
      "type": "object",
      "required": ["enabled", "revision", "strictMtls", "authorization", "controlPlaneNamespace", "controlPlaneSelector", "controlPlanePort"],
      "properties": {
        "enabled": { "type": "boolean" },
        "revision": { "type": "string" },
        "strictMtls": { "type": "boolean" },
        "authorization": {
          "type": "object",
          "required": ["enabled", "allowedPrincipals"],
          "properties": {
            "enabled": { "type": "boolean" },
            "allowedPrincipals": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "controlPlaneNamespace": { "type": "string", "minLength": 1 },
        "controlPlaneSelector": { "type": "object", "minProperties": 1 },
        "controlPlanePort": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "observability": {
      "type": "object",
      "required": ["collector", "prometheus"],
      "properties": {
        "collector": {
          "type": "object",
          "required": ["enabled", "namespace", "selector", "otlpPort"],
          "properties": {
            "enabled": { "type": "boolean" },
            "namespace": { "type": "string", "minLength": 1 },
            "selector": { "type": "object", "minProperties": 1 },
            "otlpPort": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        },
        "prometheus": {
          "type": "object",
          "required": ["enabled", "namespace", "selector", "mergeMetrics", "scrapePort"],
          "properties": {
            "enabled": { "type": "boolean" },
            "namespace": { "type": "string", "minLength": 1 },
            "selector": { "type": "object", "minProperties": 1 },
            "mergeMetrics": { "type": "boolean" },
            "scrapePort": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        }
      }
    }
  }
}
