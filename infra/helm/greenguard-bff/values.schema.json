{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["image", "replicaCount", "autoscaling", "pdb", "service", "env", "envFrom", "resources", "scheduling", "networkPolicy", "mesh", "observability"],
  "properties": {
    "image": {
      "type": "string",
      "pattern": "^.+@sha256:[a-f0-9]{64}$"
    },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "replicaCount": {
      "type": "integer",
      "minimum": 2
    },
    "autoscaling": {
      "type": "object",
      "required": ["enabled", "minReplicas", "maxReplicas", "cpuAverageUtilization"],
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 2 },
        "maxReplicas": { "type": "integer", "minimum": 3 },
        "cpuAverageUtilization": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "pdb": {
      "type": "object",
      "required": ["enabled", "minAvailable"],
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": "integer", "minimum": 1 }
      }
    },
    "service": {
      "type": "object",
      "required": ["port", "containerPort"],
      "properties": {
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "containerPort": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "env": { "type": "array", "items": { "type": "object" } },
    "envFrom": { "type": "array", "items": { "type": "object" } },
    "volumeMounts": { "type": "array", "items": { "type": "object" } },
    "volumes": { "type": "array", "items": { "type": "object" } },
    "modelGatewayTokens": {
      "type": "object",
      "required": ["enabled", "secretName", "secretKey", "filePath"],
      "properties": {
        "enabled": { "type": "boolean" },
        "secretName": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
        "secretKey": { "type": "string", "minLength": 1 },
        "filePath": { "type": "string", "pattern": "^/" }
      }
    },
    "delegationKey": {
      "type": "object",
      "required": ["secretName", "privateKeySecretKey", "keyIdSecretKey", "filePath"],
      "properties": {
        "secretName": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
        "privateKeySecretKey": { "type": "string", "minLength": 1 },
        "keyIdSecretKey": { "type": "string", "minLength": 1 },
        "filePath": { "type": "string", "pattern": "^/" }
      }
    },
    "kafka": { "type": "object", "required": ["caSecretName"], "properties": { "caSecretName": { "type": "string", "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" } } },
    "resources": {
      "type": "object",
      "required": ["requests", "limits"],
      "properties": {
        "requests": { "type": "object", "required": ["cpu", "memory"] },
        "limits": { "type": "object", "required": ["cpu", "memory"] }
      }
    },
    "scheduling": {
      "type": "object",
      "required": ["nodeSelector", "affinity", "tolerations", "topologySpreadConstraints", "priorityClassName"],
      "properties": {
        "nodeSelector": { "type": "object" },
        "affinity": { "type": "object" },
        "tolerations": { "type": "array", "items": { "type": "object" } },
        "topologySpreadConstraints": { "type": "array", "items": { "type": "object" } },
        "priorityClassName": { "type": "string" }
      }
    },
    "networkPolicy": {
      "type": "object",
      "required": ["enabled", "ingressNamespace", "ingressSelector", "egressServices", "egressPods"],
      "properties": {
        "enabled": { "type": "boolean", "const": true },
        "ingressNamespace": { "type": "string", "minLength": 1 },
        "ingressSelector": { "type": "object", "minProperties": 1 },
        "additionalIngressSources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["namespace", "selector"],
            "properties": {
              "namespace": { "type": "string", "minLength": 1 },
              "selector": { "type": "object", "minProperties": 1 }
            }
          }
        },
        "egressServices": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "namespace", "release", "port"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "namespace": { "type": "string" },
              "release": { "type": "string", "minLength": 1 },
              "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
            }
          }
        },
        "egressPods": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["namespace", "selector", "port"],
            "properties": {
              "namespace": { "type": "string", "minLength": 1 },
              "selector": { "type": "object", "minProperties": 1 },
              "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
            }
          }
        }
      }
    },
    "mesh": {
      "type": "object",
      "required": ["enabled", "revision", "strictMtls", "authorization", "controlPlaneNamespace", "controlPlaneSelector", "controlPlanePort"],
      "properties": {
        "enabled": { "type": "boolean" },
        "revision": { "type": "string" },
        "strictMtls": { "type": "boolean" },
        "authorization": {
          "type": "object",
          "required": ["enabled", "allowedPrincipals"],
          "properties": {
            "enabled": { "type": "boolean" },
            "allowedPrincipals": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "controlPlaneNamespace": { "type": "string", "minLength": 1 },
        "controlPlaneSelector": { "type": "object", "minProperties": 1 },
        "controlPlanePort": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "observability": {
      "type": "object",
      "required": ["collector", "prometheus"],
      "properties": {
        "collector": {
          "type": "object",
          "required": ["enabled", "namespace", "selector", "otlpPort"],
          "properties": {
            "enabled": { "type": "boolean" },
            "namespace": { "type": "string", "minLength": 1 },
            "selector": { "type": "object", "minProperties": 1 },
            "otlpPort": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        },
        "prometheus": {
          "type": "object",
          "required": ["enabled", "namespace", "selector", "mergeMetrics", "scrapePort"],
          "properties": {
            "enabled": { "type": "boolean" },
            "namespace": { "type": "string", "minLength": 1 },
            "selector": { "type": "object", "minProperties": 1 },
            "mergeMetrics": { "type": "boolean" },
            "scrapePort": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        }
      }
    }
  }
}
