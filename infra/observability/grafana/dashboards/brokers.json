{
  "uid": "greenguard-brokers",
  "title": "GreenGuard \u2014 Kafka, Connect and RabbitMQ",
  "tags": ["greenguard", "stage-11", "brokers"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "links": [
    {
      "title": "Platform overview",
      "url": "/d/greenguard-platform-overview/greenguard-platform-overview",
      "type": "link"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Kafka brokers",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(kafka_brokers)",
          "legendFormat": "brokers",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unknown / exporter not configured",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "values": false
        },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "description": "Alert KafkaBrokerUnavailable."
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Connect API / Schema Registry up",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "greenguard_connect_up",
          "legendFormat": "connect",
          "refId": "A"
        },
        {
          "expr": "greenguard_schema_registry_up",
          "legendFormat": "registry",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unknown / exporter not configured",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "values": false
        },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Offline / under-replicated partitions",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "count(kafka_topic_partition_leader < 0) or vector(0)",
          "legendFormat": "offline",
          "refId": "A"
        },
        {
          "expr": "sum(kafka_topic_partition_under_replicated_partition) or vector(0)",
          "legendFormat": "under-replicated",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unknown"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "values": false
        },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "RabbitMQ DLQ depth",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rabbitmq_detailed_queue_messages{queue=~\".+\\\\.dlq\"})",
          "legendFormat": "dead-lettered",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unknown / exporter not configured",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "values": false
        },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "description": "Any depth pages: RabbitMQDeadLetterQueueNotEmpty."
    },
    {
      "id": 5,
      "type": "stat",
      "title": "RabbitMQ alarms",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rabbitmq_alarms_memory_used_watermark) or vector(0)",
          "legendFormat": "memory",
          "refId": "A"
        },
        {
          "expr": "sum(rabbitmq_alarms_free_disk_space_watermark) or vector(0)",
          "legendFormat": "disk",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unknown / exporter not configured",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "values": false
        },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "description": "The alarm series exists only while an alarm is active; 0 means none."
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Binding feed age (s)",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "max(binding_feed_age_seconds)",
          "legendFormat": "age",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Unknown / exporter not configured",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 60
              },
              {
                "color": "red",
                "value": 240
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "values": false
        },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "description": "Warn 60 s, page 240 s; ingest fails closed at 300 s (ADR-0009)."
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Consumer group lag (durable groups)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "kafka:consumergroup_lag:sum",
          "legendFormat": "{{consumergroup}} {{topic}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unknown / exporter not configured"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Only the durable-consumer allowlist in rules/brokers.yaml; ephemeral test groups are excluded."
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Consumer group progress, 10m",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "kafka:consumergroup_progress:increase10m",
          "legendFormat": "{{consumergroup}} {{topic}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unknown / exporter not configured"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Zero progress with lag above zero fires KafkaConsumerGroupStalled."
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Retained records per topic",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "kafka:topic_retained_messages:sum",
          "legendFormat": "{{topic}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unknown / exporter not configured"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Latest minus oldest offset. Records, not bytes."
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Kafka partition state",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (topic) (kafka_topic_partition_under_replicated_partition)",
          "legendFormat": "{{topic}} under-replicated",
          "refId": "A"
        },
        {
          "expr": "count by (topic) (kafka_topic_partition_leader < 0)",
          "legendFormat": "{{topic}} no leader",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unknown / exporter not configured"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Connector and task state",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "greenguard_connect_connector_state{state=~\"FAILED|PAUSED|STOPPED\"} == 1",
          "legendFormat": "{{connector}} connector {{state}}",
          "refId": "A"
        },
        {
          "expr": "greenguard_connect_task_state{state=\"FAILED\"} > 0",
          "legendFormat": "{{connector}} task FAILED",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No failed or paused connectors"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Series appear only for non-running states."
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Replication slot retained WAL / cap",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "pg_wal_slot_retained_bytes / (pg_wal_slot_cap_bytes > 0)",
          "legendFormat": "{{database}} {{slot_name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "Unknown / exporter not configured"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Warn at 0.5, page at 0.75 of max_slot_wal_keep_size (docs/WAL_RETENTION.md)."
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Replication slot active / degraded",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "pg_wal_slot_active",
          "legendFormat": "{{slot_name}} active",
          "refId": "A"
        },
        {
          "expr": "pg_wal_slot_status_degraded",
          "legendFormat": "{{slot_name}} unreserved/lost",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unknown / exporter not configured"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "RabbitMQ queue depth",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "rabbitmq_detailed_queue_messages_ready",
          "legendFormat": "{{queue}} ready",
          "refId": "A"
        },
        {
          "expr": "rabbitmq_detailed_queue_messages_unacked",
          "legendFormat": "{{queue}} unacked",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unknown / exporter not configured"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "RabbitMQ consumers per queue",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 36
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "rabbitmq_detailed_queue_consumers",
          "legendFormat": "{{queue}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unknown / exporter not configured"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Retry and dead-letter queues have no consumer by design."
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "RabbitMQ memory and disk",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 36
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "rabbitmq_process_resident_memory_bytes / rabbitmq_resident_memory_limit_bytes",
          "legendFormat": "memory / limit",
          "refId": "A"
        },
        {
          "expr": "rabbitmq_disk_space_available_limit_bytes / rabbitmq_disk_space_available_bytes",
          "legendFormat": "disk limit / available",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "Unknown / exporter not configured"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Publish confirms, dead jobs, redrives",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 36
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "increase(jobs_dlq_publish_failed_total[10m])",
          "legendFormat": "DLQ publish failed 10m",
          "refId": "A"
        },
        {
          "expr": "increase(jobs_dispatch_dead_total[15m])",
          "legendFormat": "jobs dead 15m",
          "refId": "B"
        },
        {
          "expr": "rabbitmq_channel_messages_unconfirmed",
          "legendFormat": "unconfirmed",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unknown / exporter not configured"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
