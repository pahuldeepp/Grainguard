{
  "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
  "tasks.max": "1",
  "database.hostname": "postgres",
  "database.port": "5432",
  "database.user": "cdc_reader",
  "database.password": "${env:CDC_DB_PASSWORD}",
  "database.dbname": "greenguard_inventory",
  "topic.prefix": "greenguard_inventory",
  "plugin.name": "pgoutput",
  "slot.name": "greenguard_inventory_outbox",
  "slot.drop.on.stop": "false",
  "publication.name": "greenguard_outbox",
  "publication.autocreate.mode": "disabled",
  "table.include.list": "public.outbox_events",
  "snapshot.mode": "initial",
  "snapshot.locking.mode": "none",
  "tombstones.on.delete": "false",
  "include.schema.changes": "false",
  "heartbeat.interval.ms": "30000",
  "key.converter": "org.apache.kafka.connect.json.JsonConverter",
  "key.converter.schemas.enable": "false",
  "value.converter": "org.apache.kafka.connect.json.JsonConverter",
  "value.converter.schemas.enable": "false",
  "transforms": "rawTopic",
  "transforms.rawTopic.type": "org.apache.kafka.connect.transforms.RegexRouter",
  "transforms.rawTopic.regex": "^greenguard_inventory\\.(public\\.outbox_events|message)$",
  "transforms.rawTopic.replacement": "greenguard.raw.inventory.outbox",
  "heartbeat.action.query": "SELECT pg_logical_emit_message(true, 'greenguard.binding-feed', 'checkpoint')",
  "message.prefix.include.list": "greenguard\\.binding-feed"
}
