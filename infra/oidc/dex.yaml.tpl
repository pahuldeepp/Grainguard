# Local, opt-in OIDC provider for Stage 08 (ADR-0014). Rendered by the Dex
# entrypoint with gomplate; the dev password comes from the ignored .env
# (OIDC_DEV_PASSWORD, generated by scripts/bootstrap.mjs) and is hashed at start.
# Memory storage: a restart creates a new signing key (used by the rotation test).
issuer: http://127.0.0.1:5556/dex
storage:
  type: memory
web:
  http: 0.0.0.0:5556
  allowedOrigins: ["http://127.0.0.1:5173", "http://localhost:5173"]
expiry:
  idTokens: "{{ getenv "OIDC_TOKEN_TTL" "5m" }}"
  signingKeys: "6h"
oauth2:
  responseTypes: ["code"]
  skipApprovalScreen: true
  passwordConnector: local
enablePasswordDB: true
staticClients:
  - id: greenguard-dashboard
    name: GreenGuard dashboard
    public: true
    redirectURIs:
      - http://127.0.0.1:5173/auth/callback
      - http://127.0.0.1:5173/auth/silent-callback
      - http://localhost:5173/auth/callback
      - http://localhost:5173/auth/silent-callback
    # Stage 10e: the BFF accepts one audience (greenguard-dashboard). The mobile
    # client requests the cross-client scope
    # audience:server:client_id:greenguard-dashboard and this trust makes Dex
    # add that audience to its tokens, so no BFF/gateway change is needed.
    trustedPeers:
      - greenguard-mobile
  - id: greenguard-mobile
    name: GreenGuard mobile (native app, Authorization Code + PKCE)
    public: true
    redirectURIs: ["greenguard://auth/callback"]
  - id: greenguard-cli
    name: GreenGuard other client (wrong-audience fixture)
    public: true
    redirectURIs: ["http://127.0.0.1:8765/callback"]
# Identity only. Tenant and roles come from GreenGuard's membership map
# (infra/oidc/memberships.json), never from the IdP.
staticPasswords:
{{- range $u := (slice "alice" "victor" "bob") }}
  - email: {{ $u }}@greenguard.test
    hash: '{{ getenv "OIDC_DEV_PASSWORD" | crypto.Bcrypt }}'
    username: {{ $u }}
    userID: user-{{ $u }}
{{- end }}
