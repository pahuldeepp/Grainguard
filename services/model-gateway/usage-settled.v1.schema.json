{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "greenguard.ai-usage-settled.v1",
  "title": "Settled AI usage analytics, not a billing command",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tenant_id",
    "attempt_id",
    "principal_id",
    "occurred_at",
    "period",
    "model",
    "provider",
    "tokens",
    "micros",
    "usage_known"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "principal_id": {
      "anyOf": [
        {
          "const": ""
        },
        {
          "type": "string",
          "format": "uuid"
        }
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "period": {
      "type": "string",
      "format": "date"
    },
    "provider": {
      "enum": [
        "anthropic",
        "voyage",
        "legacy"
      ]
    },
    "usage_known": {
      "type": "boolean"
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "model": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "tokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "micros": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    }
  }
}
