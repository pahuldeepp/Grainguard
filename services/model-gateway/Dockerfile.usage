FROM python:3.12.10-slim-bookworm@sha256:fd95fa221297a88e1cf49c55ec1828edd7c5a428187e67b5d1805692d11588db
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY services/model-gateway/requirements.usage.lock.txt ./requirements.lock.txt
RUN pip install --no-cache-dir --disable-pip-version-check -r requirements.lock.txt \
    && useradd --uid 10001 --no-create-home --shell /usr/sbin/nologin usage-worker
COPY services/model-gateway/usage_pipeline.py ./usage_pipeline.py
USER 10001:10001
ENTRYPOINT ["python", "/app/usage_pipeline.py"]
