// Row-level security policies, grants and CHECK constraints are not expressible in
// Prisma; they live in the SQL migrations and are verified by the isolation tests.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
  runtime             = "nodejs"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  tenantId  String   @id @map("tenant_id") @db.Uuid
  name      String
  state     String   @default("active")
  homeRegion String @default("local") @map("home_region")
  version   BigInt   @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  sites     Site[]
  grainLots GrainLot[]

  @@map("tenants")
}

model Site {
  // Optimistic concurrency for future edits.
  version   BigInt   @default(1)
  tenantId  String   @map("tenant_id") @db.Uuid
  siteId    String   @map("site_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant    Tenant   @relation(fields: [tenantId], references: [tenantId], onDelete: Restrict, onUpdate: Restrict)
  bins      Bin[]
  devices   Device[]

  @@id([tenantId, siteId])
  @@map("sites")
}

model Bin {
  // Optimistic concurrency for future edits.
  version     BigInt         @default(1)
  tenantId    String         @map("tenant_id") @db.Uuid
  binId       String         @map("bin_id") @db.Uuid
  siteId      String         @map("site_id") @db.Uuid
  name        String
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  site        Site           @relation(fields: [tenantId, siteId], references: [tenantId, siteId], onDelete: Restrict, onUpdate: Restrict)
  devices     Device[]
  occupancies BinOccupancy[]
  cables      BinCable[]

  @@id([tenantId, binId])
  @@unique([tenantId, siteId, binId])
  @@map("bins")
}

model GrainLot {
  tenantId    String         @map("tenant_id") @db.Uuid
  lotId       String         @map("lot_id") @db.Uuid
  grainType   String         @map("grain_type")
  variety     String?
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant      Tenant         @relation(fields: [tenantId], references: [tenantId], onDelete: Restrict, onUpdate: Restrict)
  occupancies BinOccupancy[]

  @@id([tenantId, lotId])
  @@map("grain_lots")
}

model BinOccupancy {
  tenantId         String    @map("tenant_id") @db.Uuid
  binId            String    @map("bin_id") @db.Uuid
  occupancyVersion BigInt    @map("occupancy_version")
  lotId            String    @map("lot_id") @db.Uuid
  effectiveFrom    DateTime  @map("effective_from") @db.Timestamptz(6)
  effectiveTo      DateTime? @map("effective_to") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  bin              Bin       @relation(fields: [tenantId, binId], references: [tenantId, binId], onDelete: Restrict, onUpdate: Restrict)
  lot              GrainLot  @relation(fields: [tenantId, lotId], references: [tenantId, lotId], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, binId, occupancyVersion])
  @@unique([tenantId, lotId])
  @@index([tenantId, binId, effectiveFrom])
  @@map("bin_occupancies")
}

model Device {
  tenantId       String   @map("tenant_id") @db.Uuid
  deviceId       String   @map("device_id") @db.Uuid
  assetId        String?  @map("asset_id") @db.Uuid
  activeSagaId   String?  @map("active_saga_id") @db.Uuid
  siteId         String   @map("site_id") @db.Uuid
  binId          String?  @map("bin_id") @db.Uuid
  serialNumber   String   @map("serial_number")
  status         String
  // Optimistic concurrency: every change to assignment or lifecycle increments this.
  bindingVersion BigInt   @default(1) @map("binding_version")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  site           Site     @relation(fields: [tenantId, siteId], references: [tenantId, siteId], onDelete: Restrict, onUpdate: Restrict)
  // Composite key keeps the bin in the same tenant and the same site as the device.
  bin            Bin?     @relation(fields: [tenantId, siteId, binId], references: [tenantId, siteId, binId], onDelete: Restrict, onUpdate: Restrict)
  cables         BinCable[]

  @@id([tenantId, deviceId])
  @@unique([tenantId, serialNumber])
  @@map("devices")
}

// Layout versions are immutable in owner events. Removed identities are retained.
model BinCable {
  tenantId String @map("tenant_id") @db.Uuid
  cableId String @map("cable_id") @db.Uuid
  binId String @map("bin_id") @db.Uuid
  deviceId String @map("device_id") @db.Uuid
  label String
  version BigInt @default(1)
  status String @default("active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  bin Bin @relation(fields: [tenantId, binId], references: [tenantId, binId], onDelete: Restrict, onUpdate: Restrict)
  device Device @relation(fields: [tenantId, deviceId], references: [tenantId, deviceId], onDelete: Restrict, onUpdate: Restrict)
  sensors CableSensor[]

  @@id([tenantId, cableId])
  @@index([tenantId, binId, cableId])
  @@index([tenantId, deviceId, cableId])
  @@map("bin_cables")
}

model CableSensor {
  tenantId String @map("tenant_id") @db.Uuid
  sensorId String @map("sensor_id") @db.Uuid
  cableId String @map("cable_id") @db.Uuid
  label String
  position Int
  depthM Float? @map("depth_m")
  status String @default("active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  cable BinCable @relation(fields: [tenantId, cableId], references: [tenantId, cableId], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, sensorId])
  @@index([tenantId, cableId, position])
  @@map("cable_sensors")
}

model CommandReceipt {
  tenantId          String   @map("tenant_id") @db.Uuid
  idempotencyKey    String   @map("idempotency_key")
  commandType       String   @map("command_type")
  commandId         String   @map("command_id") @db.Uuid
  normalizedRequest Json     @map("normalized_request")
  responseBody      Json     @map("response_body")
  acceptedAt        DateTime @map("accepted_at") @db.Timestamptz(6)

  @@id([tenantId, commandType, idempotencyKey])
  @@map("command_receipts")
}

// Last accepted source coordinate for one tenant-bound external inventory entity.
model InventoryImportState {
  tenantId            String   @map("tenant_id") @db.Uuid
  sourceId            String   @map("source_id")
  entityType          String   @map("entity_type")
  externalId          String   @map("external_id")
  entityId            String   @map("entity_id") @db.Uuid
  connectorGeneration String   @map("connector_generation")
  topic               String
  partitionId         Int      @map("partition_id")
  sourceOffset        BigInt   @map("source_offset")
  payloadSha256       String   @map("payload_sha256")
  responseBody        Json     @map("response_body")
  updatedAt           DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@id([tenantId, sourceId, entityType, externalId])
  @@unique([tenantId, entityType, entityId], map: "inventory_import_state_entity_key")
  @@map("inventory_import_state")
}

model OutboxEvent {
  eventId          String   @id @map("event_id") @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  aggregateType    String   @map("aggregate_type")
  aggregateId      String   @map("aggregate_id") @db.Uuid
  aggregateVersion BigInt   @map("aggregate_version")
  eventType        String   @map("event_type")
  schemaVersion    Int      @map("schema_version")
  occurredAt       DateTime @map("occurred_at") @db.Timestamptz(6)
  correlationId    String   @map("correlation_id") @db.Uuid
  causationId      String   @map("causation_id") @db.Uuid
  traceparent      String
  payload          Json
  createdAt        DateTime @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(6)

  @@unique([tenantId, aggregateType, aggregateId, aggregateVersion])
  @@map("outbox_events")
}

model AuditEvent {
  auditId      String   @id @map("audit_id") @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  actorType    String   @map("actor_type")
  actorId      String   @map("actor_id")
  action       String
  resourceType String   @map("resource_type")
  resourceId   String   @map("resource_id") @db.Uuid
  commandId    String   @map("command_id") @db.Uuid
  eventId      String?  @map("event_id") @db.Uuid
  outcome      String
  occurredAt   DateTime @map("occurred_at") @db.Timestamptz(6)

  @@index([tenantId, resourceType, resourceId])
  @@index([tenantId, occurredAt, auditId], map: "audit_events_export_page")
  @@map("audit_events")
}

model InventorySagaReceipt {
  tenantId      String   @map("tenant_id") @db.Uuid
  commandId     String   @map("command_id") @db.Uuid
  sagaId        String   @map("saga_id") @db.Uuid
  deviceId      String   @map("device_id") @db.Uuid
  assetId       String   @map("asset_id") @db.Uuid
  step          String
  sagaVersion   BigInt   @map("saga_version")
  fencingToken  BigInt   @map("fencing_token")
  outcome       String
  resultId      String   @map("result_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  results       InventorySagaResultOutbox[]

  @@id([tenantId, commandId])
  @@map("inventory_saga_receipts")
}

model InventorySagaResultOutbox {
  tenantId      String   @map("tenant_id") @db.Uuid
  resultId      String   @map("result_id") @db.Uuid
  commandId     String   @map("command_id") @db.Uuid
  sagaId        String   @map("saga_id") @db.Uuid
  step          String
  sagaVersion   BigInt   @map("saga_version")
  fencingToken  BigInt   @map("fencing_token")
  outcome       String
  traceparent   String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)
  receipt       InventorySagaReceipt @relation(fields: [tenantId, commandId], references: [tenantId, commandId], onDelete: NoAction, onUpdate: NoAction)

  @@id([tenantId, resultId])
  @@map("inventory_saga_result_outbox")
}

model TenantEntitlement {
  tenantId String @id @map("tenant_id") @db.Uuid
  planKey String @map("plan_key")
  planVersion BigInt @map("plan_version")
  limits Json
  features Json
  sourceVersion BigInt @map("source_version")
  appliedAt DateTime @default(now()) @map("applied_at") @db.Timestamptz(6)

  @@map("tenant_entitlements")
}

// ADR-0022: per-partition entitlement feed health; no tenant data.
model EntitlementFeedHealth {
  partitionId Int @id @map("partition_id")
  verifiedAt DateTime @map("verified_at") @db.Timestamptz(6)

  @@map("entitlement_feed_health")
}
