{
  "name": "@greenguard/tenant-control-plane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:deps && prisma generate && tsc",
    "typecheck": "npm run build:deps && prisma generate && tsc --noEmit",
    "test": "npm run build && node --test --test-concurrency=1 \"dist/**/*.test.js\"",
    "coverage": "npm run build && c8 --all --src dist --extension .js --exclude \"**/*.test.js\" --exclude \"**/generated/**\" --exclude \"**/testing/**\" --reporter lcov --reporter text node --test --test-concurrency=1 \"dist/**/*.test.js\"",
    "migrate": "prisma migrate deploy",
    "seed": "node dist/seed-cli.js",
    "audit:worker": "node dist/audit/worker.js",
    "build:deps": "npm run build -w @greenguard/otel -w @greenguard/tenant-auth -w @greenguard/contracts -w @greenguard/kafka-runtime -w @greenguard/feature-flags -w @greenguard/entitlements -w @greenguard/membership-client -w @greenguard/audit",
    "entitlements:projector": "npm run build && node dist/entitlements/projector.js"
  },
  "dependencies": {
    "@greenguard/contracts": "0.1.0",
    "@greenguard/feature-flags": "0.1.0",
    "@greenguard/audit": "0.1.0",
    "@greenguard/membership-client": "0.1.0",
    "@greenguard/otel": "0.1.0",
    "@greenguard/tenant-auth": "0.1.0",
    "@nestjs/common": "12.0.4",
    "@nestjs/core": "12.0.4",
    "@nestjs/platform-express": "12.1.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "@greenguard/entitlements": "0.1.0"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "prisma": "7.10.0"
  }
}
