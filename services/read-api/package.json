{
  "name": "@greenguard/read-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build -w @greenguard/read-model -w @greenguard/membership-client && tsc",
    "typecheck": "npm run build -w @greenguard/read-model -w @greenguard/membership-client && tsc --noEmit",
    "test": "npm run build && node --test \"dist/**/*.test.js\"",
    "coverage": "npm run build && c8 --all --src dist --extension .js --exclude \"**/*.test.js\" --reporter lcov --reporter text node --test \"dist/**/*.test.js\"",
    "entitlements:projector": "npm run build && node dist/entitlements/projector.js"
  },
  "dependencies": {
    "@greenguard/read-model": "0.1.0",
    "@greenguard/tenant-auth": "0.1.0",
    "@greenguard/membership-client": "0.1.0",
    "cassandra-driver": "4.10.0",
    "express": "5.2.1",
    "ioredis": "6.0.0",
    "pg": "8.23.0",
    "@greenguard/entitlements": "0.1.0"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1"
  }
}
