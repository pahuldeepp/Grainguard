{
  "name": "greenguard-mobile-shell",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "postinstall": "node scripts/configure.mjs --ensure",
    "prestart": "node scripts/configure.mjs --ensure",
    "pretest": "node scripts/configure.mjs --ensure",
    "pretypecheck": "node scripts/configure.mjs --ensure",
    "configure:aws": "node scripts/configure.mjs --file",
    "configure:reset": "node scripts/configure.mjs --reset",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest && node --test scripts/configure.test.mjs",
    "typecheck": "npm --prefix ../../.. run build -w @greenguard/mobile && tsc --noEmit",
    "format": "prettier --write"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-native-community/netinfo": "12.0.1",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-get-random-values": "2.0.0",
    "react-native-keychain": "10.0.0",
    "react-native-safe-area-context": "5.10.0"
  },
  "devDependencies": {
    "@babel/core": "7.25.2",
    "@babel/preset-env": "7.25.3",
    "@babel/runtime": "7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@types/jest": "29.5.13",
    "@types/node": "^26.6.3",
    "@types/react": "19.2.0",
    "@types/react-test-renderer": "19.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jest": "^29.16.6",
    "jest": "29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "description": "GreenGuard Stage 10e React Native iOS shell (standalone; not a root workspace)",
  "overrides": {
    "shell-quote": "1.11.0"
  }
}
