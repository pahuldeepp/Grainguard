{
  "name": "greenguard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/dashboard",
    "apps/mobile",
    "packages/otel",
    "packages/tenant-auth",
    "packages/contracts",
    "packages/read-model",
    "packages/membership-client",
    "packages/feature-flags",
    "packages/entitlements",
    "packages/kafka-runtime",
    "packages/kafka-security",
    "packages/audit",
    "services/tenant-control-plane",
    "services/billing-service",
    "services/bff",
    "services/gateway",
    "services/device-service",
    "services/workflow-alerts",
    "services/notification-service",
    "services/read-api"
  ],
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "prebuild": "npm run build -w @greenguard/membership-client",
    "build": "npm run build --workspaces",
    "pretest": "node scripts/clean-workspace-dist.mjs && npm run build -w @greenguard/membership-client",
    "test": "npm run test --workspaces",
    "pretypecheck": "npm run build -w @greenguard/membership-client",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint apps/dashboard/src apps/mobile/src services/bff/src services/gateway/src services/device-service/src services/workflow-alerts/src services/notification-service/src services/billing-service/src packages/otel/src packages/tenant-auth/src packages/contracts/src packages/read-model/src packages/feature-flags/src packages/entitlements/src packages/audit/src packages/kafka-runtime/src scripts/*.mjs services/read-api/src services/tenant-control-plane/src packages/membership-client/src",
    "format": "prettier --write \"apps/dashboard/src/**/*.{ts,tsx,css}\" \"services/bff/src/**/*.ts\" \"services/gateway/src/**/*.ts\" \"services/device-service/src/**/*.ts\" \"services/workflow-alerts/src/**/*.ts\" \"services/notification-service/src/**/*.ts\" \"packages/*/src/**/*.ts\" \"scripts/*.mjs\" \"services/read-api/src/**/*.ts\" \"services/tenant-control-plane/src/**/*.ts\"",
    "format:check": "prettier --check \"apps/dashboard/src/**/*.{ts,tsx,css}\" \"services/bff/src/**/*.ts\" \"services/gateway/src/**/*.ts\" \"services/device-service/src/**/*.ts\" \"services/workflow-alerts/src/**/*.ts\" \"services/notification-service/src/**/*.ts\" \"packages/*/src/**/*.ts\" \"scripts/*.mjs\" \"services/read-api/src/**/*.ts\" \"services/tenant-control-plane/src/**/*.ts\"",
    "coverage": "node scripts/coverage.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.6",
    "c8": "^12.0.0",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "prettier": "3.9.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.4"
  }
}
