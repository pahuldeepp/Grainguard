{
  "name": "@greenguard/audit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "verify-audit-export": "dist/verify-cli.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test \"dist/**/*.test.js\"",
    "coverage": "npm run build && c8 --all --src dist --extension .js --exclude \"**/*.test.js\" --reporter lcov --reporter text node --test \"dist/**/*.test.js\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1141.0",
    "@aws-sdk/lib-storage": "3.1141.0",
    "@aws-sdk/s3-request-presigner": "3.1141.0"
  }
}
