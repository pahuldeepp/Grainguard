{
  "name": "@greenguard/membership-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "./owner-db": {
      "types": "./dist/owner-db.d.ts",
      "default": "./dist/owner-db.js"
    },
    "./watermark": {
      "types": "./dist/watermark.d.ts",
      "default": "./dist/watermark.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "npm run build:deps && tsc",
    "typecheck": "npm run build:deps && tsc --noEmit",
    "test": "npm run build && node --test \"dist/**/*.test.js\"",
    "coverage": "npm run build && c8 --all --src dist --extension .js --exclude \"**/*.test.js\" --reporter lcov --reporter text node --test \"dist/**/*.test.js\"",
    "build:deps": "npm run build -w @greenguard/tenant-auth -w @greenguard/kafka-security"
  },
  "dependencies": {
    "@greenguard/tenant-auth": "0.1.0",
    "jose": "6.2.12",
    "kafkajs": "2.2.4",
    "kafkajs-snappy": "1.1.0",
    "redis": "5.1.1",
    "@greenguard/kafka-security": "0.1.0"
  }
}
