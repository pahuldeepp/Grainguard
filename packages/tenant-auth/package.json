{
  "name": "@greenguard/tenant-auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./oidc": {
      "types": "./dist/oidc.d.ts",
      "default": "./dist/oidc.js"
    },
    "./service-principals": {
      "types": "./dist/service-principals.d.ts",
      "default": "./dist/service-principals.js"
    },
    "./machine-control-plane": {
      "types": "./dist/machine-control-plane.d.ts",
      "default": "./dist/machine-control-plane.js"
    },
    "./issuers": {
      "types": "./dist/issuers.d.ts",
      "default": "./dist/issuers.js"
    },
    "./testing": {
      "types": "./dist/testing/issuer.d.ts",
      "default": "./dist/testing/issuer.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test \"dist/**/*.test.js\"",
    "coverage": "npm run build && c8 --all --src dist --extension .js --exclude \"**/*.test.js\" --exclude \"**/testing/**\" --reporter lcov --reporter text node --test \"dist/**/*.test.js\""
  },
  "dependencies": {
    "jose": "6.2.12"
  }
}
