{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:greenguard:contracts:events:telemetry-recorded:v2",
  "$comment": "ADR-0027 additive telemetry. Finite values, unit parity, unique sensor/metric identities and authorized owner layout provenance are enforced by validators and ingest. v1 is immutable.",
  "title": "GreenGuard telemetry.recorded v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "occurred_at",
    "tenant_id",
    "aggregate_type",
    "aggregate_id",
    "aggregate_version",
    "correlation_id",
    "causation_id",
    "traceparent",
    "payload"
  ],
  "properties": {
    "event_id": {
      "$ref": "#/$defs/uuid"
    },
    "event_type": {
      "const": "telemetry.recorded"
    },
    "schema_version": {
      "const": 2
    },
    "occurred_at": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "tenant_id": {
      "$ref": "#/$defs/uuid"
    },
    "aggregate_type": {
      "const": "device_telemetry_stream"
    },
    "aggregate_id": {
      "$ref": "#/$defs/uuid"
    },
    "aggregate_version": {
      "$ref": "#/$defs/positiveBigintString"
    },
    "correlation_id": {
      "$ref": "#/$defs/uuid"
    },
    "causation_id": {
      "$ref": "#/$defs/uuid"
    },
    "traceparent": {
      "description": "W3C version-00 context; application validation rejects all-zero trace or parent IDs. Persist the originating context unchanged across retries and replay.",
      "type": "string",
      "pattern": "^00-[0-9a-f]{32}-[0-9a-f]{16}-(00|01)$"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reading_id",
        "device_id",
        "site_id",
        "bin_id",
        "binding_version",
        "source_message_id",
        "observed_at",
        "received_at",
        "measurements",
        "measurement_units"
      ],
      "properties": {
        "reading_id": {
          "$ref": "#/$defs/uuid"
        },
        "device_id": {
          "$ref": "#/$defs/uuid"
        },
        "site_id": {
          "$ref": "#/$defs/uuid"
        },
        "bin_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "binding_version": {
          "$ref": "#/$defs/positiveBigintString"
        },
        "source_message_id": {
          "description": "Stable device-generated reading identity, reused on retries; scoped to tenant and device. Generated before the first transmission.",
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "observed_at": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "received_at": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "measurements": {
          "description": "Independent actual measurements. Missing quantities remain absent; air RH never substitutes for grain moisture.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "temperature_c": {
              "type": "number",
              "minimum": -80,
              "maximum": 120
            },
            "relative_humidity_percent": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "co2_ppm": {
              "type": "number",
              "minimum": 0
            },
            "grain_moisture_percent": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          }
        },
        "measurement_units": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "temperature_c": {
              "const": "Cel"
            },
            "relative_humidity_percent": {
              "const": "%"
            },
            "co2_ppm": {
              "const": "ppm"
            },
            "grain_moisture_percent": {
              "const": "%"
            }
          }
        },
        "sensor_observations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sensor_id",
              "metric",
              "value",
              "unit",
              "layout_version",
              "cable_id",
              "position",
              "depth_m"
            ],
            "properties": {
              "sensor_id": {
                "$ref": "#/$defs/uuid"
              },
              "cable_id": {
                "$ref": "#/$defs/uuid"
              },
              "layout_version": {
                "$ref": "#/$defs/positiveBigintString"
              },
              "position": {
                "type": "integer",
                "minimum": 1
              },
              "depth_m": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "metric": {
                "enum": [
                  "temperature_c",
                  "relative_humidity_percent",
                  "co2_ppm",
                  "grain_moisture_percent"
                ]
              },
              "value": {
                "type": "number"
              },
              "unit": {
                "enum": [
                  "Cel",
                  "%",
                  "ppm"
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "metric": {
                      "const": "temperature_c"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "unit": {
                      "const": "Cel"
                    },
                    "value": {
                      "type": "number",
                      "minimum": -80,
                      "maximum": 120
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "metric": {
                      "const": "relative_humidity_percent"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "unit": {
                      "const": "%"
                    },
                    "value": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "metric": {
                      "const": "co2_ppm"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "unit": {
                      "const": "ppm"
                    },
                    "value": {
                      "type": "number",
                      "minimum": 0
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "metric": {
                      "const": "grain_moisture_percent"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "unit": {
                      "const": "%"
                    },
                    "value": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "anyOf": [
        {
          "properties": {
            "measurements": {
              "minProperties": 1,
              "type": "object"
            }
          }
        },
        {
          "required": [
            "sensor_observations"
          ],
          "properties": {
            "sensor_observations": {}
          }
        }
      ]
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "positiveBigintString": {
      "description": "Positive PostgreSQL signed bigint serialized as a decimal string. The consumer must also enforce <= 9223372036854775807; regex alone does not enforce the numeric upper bound.",
      "type": "string",
      "minLength": 1,
      "maxLength": 19,
      "pattern": "^[1-9][0-9]{0,18}$"
    }
  }
}
