{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:greenguard:contracts:events:device-status-changed:v1",
  "$comment": "Immutable strict v1. Compile with date-time and uuid format assertions enabled; cross-field rules are enforced by @greenguard/contracts.",
  "title": "GreenGuard device.status_changed v1 (device status changed)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "occurred_at",
    "tenant_id",
    "aggregate_type",
    "aggregate_id",
    "aggregate_version",
    "correlation_id",
    "causation_id",
    "traceparent",
    "payload"
  ],
  "properties": {
    "event_id": {
      "$ref": "#/$defs/uuid"
    },
    "event_type": {
      "const": "device.status_changed"
    },
    "schema_version": {
      "const": 1
    },
    "occurred_at": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "tenant_id": {
      "$ref": "#/$defs/uuid"
    },
    "aggregate_type": {
      "const": "device"
    },
    "aggregate_id": {
      "$ref": "#/$defs/uuid"
    },
    "aggregate_version": {
      "$ref": "#/$defs/positiveBigintString"
    },
    "correlation_id": {
      "$ref": "#/$defs/uuid"
    },
    "causation_id": {
      "$ref": "#/$defs/uuid"
    },
    "traceparent": {
      "type": "string",
      "pattern": "^00-[0-9a-f]{32}-[0-9a-f]{16}-(00|01)$"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device_id", "status", "binding_version"],
      "properties": {
        "device_id": {
          "$ref": "#/$defs/uuid"
        },
        "status": {
          "enum": ["active", "disabled", "deleted"]
        },
        "binding_version": {
          "$ref": "#/$defs/positiveBigintString"
        }
      }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "positiveBigintString": {
      "description": "Positive PostgreSQL signed bigint as a decimal string. Consumers must also enforce <= 9223372036854775807.",
      "type": "string",
      "minLength": 1,
      "maxLength": 19,
      "pattern": "^[1-9][0-9]{0,18}$"
    }
  }
}
