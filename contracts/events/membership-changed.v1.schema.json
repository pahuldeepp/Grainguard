{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:greenguard:contracts:events:membership-changed:v1",
  "$comment": "Immutable strict v1. Compile with date-time and uuid format assertions enabled; cross-field rules are enforced by @greenguard/contracts. identity_id is the name-based hash of issuer|subject (@greenguard/membership-client identityKey); raw IdP subjects never travel on the bus.",
  "title": "GreenGuard membership.changed v1 (first-party membership granted, accepted, role changed or revoked)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "occurred_at",
    "tenant_id",
    "aggregate_type",
    "aggregate_id",
    "aggregate_version",
    "correlation_id",
    "causation_id",
    "traceparent",
    "payload"
  ],
  "properties": {
    "event_id": {
      "$ref": "#/$defs/uuid"
    },
    "event_type": {
      "const": "membership.changed"
    },
    "schema_version": {
      "const": 1
    },
    "occurred_at": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "tenant_id": {
      "$ref": "#/$defs/uuid"
    },
    "aggregate_type": {
      "const": "membership"
    },
    "aggregate_id": {
      "$ref": "#/$defs/uuid"
    },
    "aggregate_version": {
      "$ref": "#/$defs/positiveBigintString"
    },
    "correlation_id": {
      "$ref": "#/$defs/uuid"
    },
    "causation_id": {
      "$ref": "#/$defs/uuid"
    },
    "traceparent": {
      "type": "string",
      "pattern": "^00-[0-9a-f]{32}-[0-9a-f]{16}-(00|01)$"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "membership_id",
        "membership_version",
        "identity_id",
        "role",
        "state",
        "action",
        "effective_at",
        "actor_identity_id"
      ],
      "properties": {
        "membership_id": {
          "$ref": "#/$defs/uuid"
        },
        "membership_version": {
          "$ref": "#/$defs/positiveBigintString"
        },
        "identity_id": {
          "$ref": "#/$defs/uuid"
        },
        "role": {
          "enum": [
            "viewer",
            "operator",
            "admin"
          ]
        },
        "state": {
          "enum": [
            "active",
            "revoked"
          ]
        },
        "action": {
          "enum": [
            "granted",
            "accepted",
            "role_changed",
            "revoked"
          ]
        },
        "effective_at": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "actor_identity_id": {
          "$ref": "#/$defs/uuid"
        }
      }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "positiveBigintString": {
      "description": "Positive PostgreSQL signed bigint as a decimal string. Consumers must also enforce <= 9223372036854775807.",
      "type": "string",
      "minLength": 1,
      "maxLength": 19,
      "pattern": "^[1-9][0-9]{0,18}$"
    }
  }
}
