{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:greenguard:contracts:events:cable-layout-changed:v1",
  "$comment": "Immutable complete current cable layout. Removing sensors omits their IDs; deleted layouts contain no sensors. Depth is nullable meters; no physical asset identity is used.",
  "title": "GreenGuard cable.layout_changed v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "occurred_at",
    "tenant_id",
    "aggregate_type",
    "aggregate_id",
    "aggregate_version",
    "correlation_id",
    "causation_id",
    "traceparent",
    "payload"
  ],
  "properties": {
    "event_id": {
      "$ref": "#/$defs/uuid"
    },
    "event_type": {
      "const": "cable.layout_changed"
    },
    "schema_version": {
      "const": 1
    },
    "occurred_at": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "tenant_id": {
      "$ref": "#/$defs/uuid"
    },
    "aggregate_type": {
      "const": "cable"
    },
    "aggregate_id": {
      "$ref": "#/$defs/uuid"
    },
    "aggregate_version": {
      "$ref": "#/$defs/positiveBigintString"
    },
    "correlation_id": {
      "$ref": "#/$defs/uuid"
    },
    "causation_id": {
      "$ref": "#/$defs/uuid"
    },
    "traceparent": {
      "type": "string",
      "pattern": "^00-[0-9a-f]{32}-[0-9a-f]{16}-(00|01)$"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device_id",
        "bin_id",
        "cable_id",
        "cable_version",
        "operation",
        "sensors"
      ],
      "properties": {
        "device_id": {
          "$ref": "#/$defs/uuid"
        },
        "bin_id": {
          "$ref": "#/$defs/uuid"
        },
        "cable_id": {
          "$ref": "#/$defs/uuid"
        },
        "cable_version": {
          "$ref": "#/$defs/positiveBigintString"
        },
        "operation": {
          "enum": [
            "upsert",
            "deleted"
          ]
        },
        "sensors": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sensor_id",
              "position",
              "label",
              "depth_m"
            ],
            "properties": {
              "sensor_id": {
                "$ref": "#/$defs/uuid"
              },
              "position": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "\\S"
              },
              "depth_m": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "operation": {
                "const": "deleted"
              }
            },
            "required": [
              "operation"
            ]
          },
          "then": {
            "properties": {
              "sensors": {
                "maxItems": 0,
                "type": "array"
              }
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "positiveBigintString": {
      "description": "Positive PostgreSQL signed bigint as a decimal string. Consumers must also enforce <= 9223372036854775807.",
      "type": "string",
      "minLength": 1,
      "maxLength": 19,
      "pattern": "^[1-9][0-9]{0,18}$"
    }
  }
}
