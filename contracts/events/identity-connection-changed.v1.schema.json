{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:greenguard:contracts:events:identity-connection-changed:v1",
  "title": "GreenGuard identity_connection.changed v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_type", "schema_version", "occurred_at", "tenant_id", "aggregate_type", "aggregate_id", "aggregate_version", "correlation_id", "causation_id", "traceparent", "payload"],
  "properties": {
    "event_id": { "$ref": "#/$defs/uuid" },
    "event_type": { "const": "identity_connection.changed" },
    "schema_version": { "const": 1 },
    "occurred_at": { "$ref": "#/$defs/utcTimestamp" },
    "tenant_id": { "$ref": "#/$defs/uuid" },
    "aggregate_type": { "const": "identity_connection" },
    "aggregate_id": { "$ref": "#/$defs/uuid" },
    "aggregate_version": { "$ref": "#/$defs/positiveBigintString" },
    "correlation_id": { "$ref": "#/$defs/uuid" },
    "causation_id": { "$ref": "#/$defs/uuid" },
    "traceparent": { "type": "string", "pattern": "^00-[0-9a-f]{32}-[0-9a-f]{16}-(00|01)$" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["connection_id", "connection_version", "jit_enabled"],
      "properties": {
        "connection_id": { "$ref": "#/$defs/uuid" },
        "connection_version": { "$ref": "#/$defs/positiveBigintString" },
        "jit_enabled": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "uuid": { "type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "utcTimestamp": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$" },
    "positiveBigintString": { "type": "string", "minLength": 1, "maxLength": 19, "pattern": "^[1-9][0-9]{0,18}$" }
  }
}
