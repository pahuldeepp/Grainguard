{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:greenguard:contracts:events:telemetry-recorded:v1",
  "$comment": "PROPOSED new GreenGuard contract. This is not the archived GrainGuard or CarePulse event schema, and no producer or consumer is implemented yet. Compile with date-time and uuid format assertions enabled; enforce cross-field and authorization rules in FIRST_VERTICAL_SLICE.md.",
  "title": "GreenGuard telemetry.recorded v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id", "event_type", "schema_version", "occurred_at", "tenant_id",
    "aggregate_type", "aggregate_id", "aggregate_version", "correlation_id",
    "causation_id", "traceparent", "payload"
  ],
  "properties": {
    "event_id": { "$ref": "#/$defs/uuid" },
    "event_type": { "const": "telemetry.recorded" },
    "schema_version": { "const": 1 },
    "occurred_at": { "$ref": "#/$defs/utcTimestamp" },
    "tenant_id": { "$ref": "#/$defs/uuid" },
    "aggregate_type": { "const": "device_telemetry_stream" },
    "aggregate_id": { "$ref": "#/$defs/uuid" },
    "aggregate_version": { "$ref": "#/$defs/positiveBigintString" },
    "correlation_id": { "$ref": "#/$defs/uuid" },
    "causation_id": { "$ref": "#/$defs/uuid" },
    "traceparent": {
      "description": "W3C version-00 context; application validation rejects all-zero trace or parent IDs. Persist the originating context unchanged across retries and replay.",
      "type": "string",
      "pattern": "^00-[0-9a-f]{32}-[0-9a-f]{16}-(00|01)$"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reading_id", "device_id", "site_id", "bin_id", "binding_version",
        "source_message_id", "observed_at", "received_at", "measurements"
      ],
      "properties": {
        "reading_id": { "$ref": "#/$defs/uuid" },
        "device_id": { "$ref": "#/$defs/uuid" },
        "site_id": { "$ref": "#/$defs/uuid" },
        "bin_id": { "anyOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] },
        "binding_version": { "$ref": "#/$defs/positiveBigintString" },
        "source_message_id": {
          "description": "Stable device-generated reading identity, reused on retries; scoped to tenant and device. Generated before the first transmission.",
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "observed_at": { "$ref": "#/$defs/utcTimestamp" },
        "received_at": { "$ref": "#/$defs/utcTimestamp" },
        "measurements": {
          "description": "First-slice device input limits, not agronomic alert thresholds; future metric sets need a versioned contract.",
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "temperature_c": { "type": "number", "minimum": -80, "maximum": 120 },
            "relative_humidity_percent": { "type": "number", "minimum": 0, "maximum": 100 }
          }
        }
      }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "positiveBigintString": {
      "description": "Positive PostgreSQL signed bigint serialized as a decimal string. The consumer must also enforce <= 9223372036854775807; regex alone does not enforce the numeric upper bound.",
      "type": "string",
      "minLength": 1,
      "maxLength": 19,
      "pattern": "^[1-9][0-9]{0,18}$"
    }
  }
}
