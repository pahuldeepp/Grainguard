{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:greenguard:contracts:events:risk-policy-changed:v1",
  "title": "GreenGuard risk.policy_changed v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_type", "schema_version", "occurred_at", "tenant_id", "aggregate_type", "aggregate_id", "aggregate_version", "correlation_id", "causation_id", "traceparent", "payload"],
  "properties": {
    "event_id": { "$ref": "#/$defs/uuid" },
    "event_type": { "const": "risk.policy_changed" },
    "schema_version": { "const": 1 },
    "occurred_at": { "$ref": "#/$defs/utcTimestamp" },
    "tenant_id": { "$ref": "#/$defs/uuid" },
    "aggregate_type": { "const": "grain_policy" },
    "aggregate_id": { "$ref": "#/$defs/uuid" },
    "aggregate_version": { "$ref": "#/$defs/positiveBigintString" },
    "correlation_id": { "$ref": "#/$defs/uuid" },
    "causation_id": { "$ref": "#/$defs/uuid" },
    "traceparent": { "type": "string", "pattern": "^00-[0-9a-f]{32}-[0-9a-f]{16}-(00|01)$" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "version", "grain_type", "bin_id", "effective_from", "effective_to", "measurement_thresholds", "risk_thresholds", "calibrated", "status", "provenance", "calibration_evidence", "approved_by", "approved_at", "supersedes"],
      "properties": {
        "policy_id": { "$ref": "#/$defs/uuid" },
        "version": { "$ref": "#/$defs/positiveBigintString" },
        "grain_type": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$" },
        "bin_id": { "anyOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] },
        "effective_from": { "$ref": "#/$defs/utcTimestamp" },
        "effective_to": { "anyOf": [{ "$ref": "#/$defs/utcTimestamp" }, { "type": "null" }] },
        "measurement_thresholds": { "type": "object", "additionalProperties": { "$ref": "#/$defs/measurementThreshold" } },
        "risk_thresholds": { "type": "object", "additionalProperties": false, "required": ["warning_score", "critical_score"], "properties": { "warning_score": { "type": "integer", "minimum": 1, "maximum": 100 }, "critical_score": { "type": "integer", "minimum": 1, "maximum": 100 } } },
        "calibrated": { "type": "boolean" },
        "status": { "enum": ["draft", "active"] },
        "provenance": { "type": "object", "minProperties": 1 },
        "calibration_evidence": { "type": ["string", "null"] },
        "approved_by": { "type": ["string", "null"] },
        "approved_at": { "anyOf": [{ "$ref": "#/$defs/utcTimestamp" }, { "type": "null" }] },
        "supersedes": { "anyOf": [{ "type": "null" }, { "type": "object", "additionalProperties": false, "required": ["policy_id", "version"], "properties": { "policy_id": { "$ref": "#/$defs/uuid" }, "version": { "$ref": "#/$defs/positiveBigintString" } } }] }
      }
    }
  },
  "$defs": {
    "uuid": { "type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "utcTimestamp": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$" },
    "positiveBigintString": { "type": "string", "minLength": 1, "maxLength": 19, "pattern": "^[1-9][0-9]{0,18}$" },
    "measurementThreshold": { "type": "object", "additionalProperties": false, "required": ["unit"], "properties": { "warning": { "type": ["number", "null"] }, "critical": { "type": ["number", "null"] }, "unit": { "enum": ["Cel", "%", "ppm"] } } }
  }
}
