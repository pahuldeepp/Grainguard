# bootstrap generates random local credentials in ignored .env; never use these placeholders.
POSTGRES_PASSWORD=replace_me
INVENTORY_DB_PASSWORD=replace_me
INVENTORY_MIGRATOR_PASSWORD=replace_me
TELEMETRY_DB_PASSWORD=replace_me
# Runtime traffic goes through PgBouncer (transaction pooling).
INVENTORY_DATABASE_URL=postgresql://inventory_app:replace_me@127.0.0.1:56432/greenguard_inventory
# Direct connections: session-level checks, migrations (table owner) and test administration only.
INVENTORY_DIRECT_URL=postgresql://inventory_app:replace_me@127.0.0.1:55432/greenguard_inventory
INVENTORY_MIGRATION_URL=postgresql://inventory_migrator:replace_me@127.0.0.1:55432/greenguard_inventory
TELEMETRY_DATABASE_URL=postgresql://telemetry_app:replace_me@127.0.0.1:55432/greenguard_telemetry
POSTGRES_ADMIN_URL=postgresql://postgres:replace_me@127.0.0.1:55432/postgres
