# bootstrap generates random local credentials in ignored .env; never use these placeholders.
CDC_DB_PASSWORD=replace_me
POSTGRES_PASSWORD=replace_me
# Loopback host ports for the local database stack; update the *_URL ports below if changed.
POSTGRES_HOST_PORT=55432
PGBOUNCER_HOST_PORT=56432
# Optional local Kafka overlay host ports. Stage 07 can override these to run
# isolated beside the shared development brokers without stopping them.
KAFKA_HOST_PORT=59092
MQTT_HOST_PORT=51883
SCHEMA_REGISTRY_HOST_PORT=58081
KAFKA_CONNECT_HOST_PORT=58083
STAGE07_KAFKA_BROKERS=127.0.0.1:59092
STAGE07_MQTT_BROKER_URL=tcp://127.0.0.1:51883
KAFKA_CONNECT_URL=http://127.0.0.1:58083
SCHEMA_REGISTRY_URL=http://127.0.0.1:58081
OBSERVABILITY_DB_PASSWORD=replace_me
INVENTORY_DB_PASSWORD=replace_me
INVENTORY_PROJECTOR_PASSWORD=replace_me
INVENTORY_MIGRATOR_PASSWORD=replace_me
INVENTORY_AUDIT_READER_PASSWORD=replace_me
TELEMETRY_DB_PASSWORD=replace_me
TELEMETRY_ENTITLEMENT_PROJECTOR_PASSWORD=replace_me
TELEMETRY_MIGRATOR_PASSWORD=replace_me
# Runtime traffic goes through PgBouncer (transaction pooling).
INVENTORY_DATABASE_URL=postgresql://inventory_app:replace_me@127.0.0.1:56432/greenguard_inventory
# Direct connections: session-level checks, migrations (table owner) and test administration only.
INVENTORY_DIRECT_URL=postgresql://inventory_app:replace_me@127.0.0.1:55432/greenguard_inventory
INVENTORY_PROJECTOR_DIRECT_URL=postgresql://inventory_projector:replace_me@127.0.0.1:55432/greenguard_inventory
INVENTORY_MIGRATION_URL=postgresql://inventory_migrator:replace_me@127.0.0.1:55432/greenguard_inventory
# Runtime traffic goes through PgBouncer (transaction pooling); the Go service must not use prepared statements.
TELEMETRY_DATABASE_URL=postgresql://telemetry_app:replace_me@127.0.0.1:56432/greenguard_telemetry
TELEMETRY_DIRECT_URL=postgresql://telemetry_app:replace_me@127.0.0.1:55432/greenguard_telemetry
TELEMETRY_ENTITLEMENT_PROJECTOR_URL=postgresql://telemetry_entitlement_projector:replace_me@127.0.0.1:55432/greenguard_telemetry
TELEMETRY_MIGRATION_URL=postgresql://telemetry_migrator:replace_me@127.0.0.1:55432/greenguard_telemetry
POSTGRES_ADMIN_URL=postgresql://postgres:replace_me@127.0.0.1:55432/postgres

PROJECTION_DB_PASSWORD=replace_me
READ_ENTITLEMENT_PROJECTOR_PASSWORD=replace_me
PROJECTION_MIGRATOR_PASSWORD=replace_me
PROJECTION_HISTORY_MAINTAINER_PASSWORD=replace_me
PROJECTION_DATABASE_URL=postgresql://projection_app:replace_me@127.0.0.1:56432/greenguard_read
PROJECTION_DIRECT_URL=postgresql://projection_app:replace_me@127.0.0.1:55432/greenguard_read
READ_ENTITLEMENT_PROJECTOR_URL=postgresql://read_entitlement_projector:replace_me@127.0.0.1:55432/greenguard_read
PROJECTION_MIGRATION_URL=postgresql://projection_migrator:replace_me@127.0.0.1:55432/greenguard_read
READ_QUERY_DB_PASSWORD=replace_me
READ_QUERY_DATABASE_URL=postgresql://read_query:replace_me@127.0.0.1:56432/greenguard_read
# Keep aligned with PROJECTION_HISTORY_HOT_WINDOW; used to split PostgreSQL/Cassandra history.
READ_HISTORY_HOT_WINDOW=24h
# Dedicated private HMAC key, generated by bootstrap; stable across read replicas.
READ_HISTORY_CURSOR_SECRET=
# Optional local Redis; production Redis Cluster uses comma-separated redis[s]:// startup URLs.
READ_REDIS_URL=
READ_REDIS_CLUSTER_NODES=
READ_HISTORY_CONCURRENCY=32
READ_HISTORY_TENANT_CONCURRENCY=4
READ_SEARCH_CONCURRENCY=64
READ_SEARCH_TENANT_CONCURRENCY=8
# Optional announced-host=reachable-host map, e.g. redis-node-1:6379=127.0.0.1:7101
READ_REDIS_NODE_ADDRESS_MAP=
BFF_RATE_REDIS_URL=
BFF_RATE_REDIS_CLUSTER_NODES=
BFF_ALLOW_NO_RATE_LIMIT=true
# Optional Vite-only target when Assistant routes use a separate local BFF.
# BFF_ASSISTANT_DEV_URL=http://127.0.0.1:4002
# Optional operator-only ML operations proxy. The scorer remains synthetic/shadow
# until its model is independently validated for production.
ML_OPERATIONS_URL=http://127.0.0.1:8080
ML_OPERATIONS_TOKEN=

RISK_DB_PASSWORD=replace_me
RISK_MIGRATOR_PASSWORD=replace_me
RISK_DATABASE_URL=postgresql://risk_app:replace_me@127.0.0.1:56432/greenguard_risk
RISK_DIRECT_URL=postgresql://risk_app:replace_me@127.0.0.1:55432/greenguard_risk
RISK_MIGRATION_URL=postgresql://risk_migrator:replace_me@127.0.0.1:55432/greenguard_risk

JOBS_DB_PASSWORD=replace_me
JOBS_MIGRATOR_PASSWORD=replace_me
JOBS_DATABASE_URL=postgresql://jobs_app:replace_me@127.0.0.1:56432/greenguard_jobs
JOBS_DIRECT_URL=postgresql://jobs_app:replace_me@127.0.0.1:55432/greenguard_jobs
JOBS_MIGRATION_URL=postgresql://jobs_migrator:replace_me@127.0.0.1:55432/greenguard_jobs
NOTIFICATIONS_DB_PASSWORD=replace_me
NOTIFICATIONS_MIGRATOR_PASSWORD=replace_me
NOTIFICATIONS_DATABASE_URL=postgresql://notifications_app:replace_me@127.0.0.1:56432/greenguard_notifications
NOTIFICATIONS_DIRECT_URL=postgresql://notifications_app:replace_me@127.0.0.1:55432/greenguard_notifications
NOTIFICATIONS_MIGRATION_URL=postgresql://notifications_migrator:replace_me@127.0.0.1:55432/greenguard_notifications
JOBS_NOTIFICATION_CURSOR_KEY=
NOTIFICATIONS_AUDIT_HMAC_KEY=
# Owner notification read APIs accept verified RS256 principals from this issuer.
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_JWKS_URL=
ALERTS_DB_PASSWORD=replace_me
ALERTS_MIGRATOR_PASSWORD=replace_me
ALERTS_DATABASE_URL=postgresql://alerts_app:replace_me@127.0.0.1:56432/greenguard_alerts
ALERTS_DIRECT_URL=postgresql://alerts_app:replace_me@127.0.0.1:55432/greenguard_alerts
ALERTS_MIGRATION_URL=postgresql://alerts_migrator:replace_me@127.0.0.1:55432/greenguard_alerts
SAGA_DB_PASSWORD=replace_me
SAGA_MIGRATOR_PASSWORD=replace_me
SAGA_DATABASE_URL=postgresql://saga_app:replace_me@127.0.0.1:56432/greenguard_sagas
SAGA_DIRECT_URL=postgresql://saga_app:replace_me@127.0.0.1:55432/greenguard_sagas
SAGA_MIGRATION_URL=postgresql://saga_migrator:replace_me@127.0.0.1:55432/greenguard_sagas
HARDWARE_DB_PASSWORD=replace_me
HARDWARE_MIGRATOR_PASSWORD=replace_me
HARDWARE_DATABASE_URL=postgresql://hardware_app:replace_me@127.0.0.1:56432/greenguard_hardware
HARDWARE_DIRECT_URL=postgresql://hardware_app:replace_me@127.0.0.1:55432/greenguard_hardware
HARDWARE_MIGRATION_URL=postgresql://hardware_migrator:replace_me@127.0.0.1:55432/greenguard_hardware
# Stage 09a tenant-control-plane (greenguard_control). AUTH_MEMBERSHIP_SOURCE=file keeps
# the static membership file; control-plane switches verifiers to the lookup API.
CONTROL_DB_PASSWORD=replace_me
CONTROL_ENTITLEMENT_PROJECTOR_PASSWORD=replace_me
CONTROL_MIGRATOR_PASSWORD=replace_me
CONTROL_AUDIT_WORKER_PASSWORD=replace_me
CONTROL_BOOTSTRAP_WORKER_PASSWORD=replace_me
CONTROL_BOOTSTRAP_DATABASE_URL=postgresql://tenant_bootstrap_worker:replace_me@127.0.0.1:55432/greenguard_control
BILLING_DB_PASSWORD=replace_me
BILLING_MIGRATOR_PASSWORD=replace_me
BILLING_AUDIT_READER_PASSWORD=replace_me
BILLING_DATABASE_URL=postgresql://billing_app:replace_me@127.0.0.1:56432/greenguard_billing
BILLING_DIRECT_URL=postgresql://billing_app:replace_me@127.0.0.1:55432/greenguard_billing
BILLING_MIGRATION_URL=postgresql://billing_migrator:replace_me@127.0.0.1:55432/greenguard_billing
# Stage 09d: test-mode Stripe only. Never commit real keys or webhook payloads.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRETS=
BILLING_INBOX_ENCRYPTION_KEY=
BILLING_KAFKA_BROKERS=127.0.0.1:59092
CONTROL_DATABASE_URL=postgresql://control_app:replace_me@127.0.0.1:56432/greenguard_control
CONTROL_DIRECT_URL=postgresql://control_app:replace_me@127.0.0.1:55432/greenguard_control
CONTROL_ENTITLEMENT_PROJECTOR_URL=postgresql://control_entitlement_projector:replace_me@127.0.0.1:55432/greenguard_control
CONTROL_MIGRATION_URL=postgresql://control_migrator:replace_me@127.0.0.1:55432/greenguard_control
CONTROL_AUDIT_DATABASE_URL=postgresql://control_audit_worker:replace_me@127.0.0.1:55432/greenguard_control
BILLING_AUDIT_DATABASE_URL=postgresql://billing_audit_reader:replace_me@127.0.0.1:55432/greenguard_billing
# Shared service credential for internal lookups (>= 32 bytes; startup fails otherwise).
# Generate one with: openssl rand -base64 48
CONTROL_LOOKUP_TOKEN=
# Optional Stage 09g multi-IdP allow-list; JSON array of issuer/audience/jwksUrl.
# Leave empty when using legacy AUTH_ISSUER/AUTH_AUDIENCE/AUTH_JWKS_URL.
AUTH_ISSUERS_JSON=
CONTROL_FLAG_ADMIN_TOKEN=
CONTROL_FLAG_ADMIN_ACTOR_ID=
AUDIT_EXPORT_DIRECTORY=
AUDIT_EXPORT_PUBLIC_KEY_PEM=
AUDIT_EXPORT_PRIVATE_KEY_PEM=
AUDIT_EXPORT_PUBLIC_KEY_ID=
AUDIT_EXPORT_LINK_SECRET=
# Stage 09e object storage: set AUDIT_EXPORT_S3_BUCKET to use S3 instead of the directory.
# Bucket and region must be set together; leave all AUDIT_EXPORT_S3_* empty for the directory backend.
# Credentials come from the AWS provider chain (IAM role); the static pair is for local MinIO only.
AUDIT_EXPORT_S3_BUCKET=
AUDIT_EXPORT_S3_REGION=
AUDIT_EXPORT_S3_ENDPOINT=
AUDIT_EXPORT_S3_FORCE_PATH_STYLE=
AUDIT_EXPORT_S3_ACCESS_KEY_ID=
AUDIT_EXPORT_S3_SECRET_ACCESS_KEY=
AUDIT_EXPORT_S3_KMS_KEY_ID=
AUDIT_EXPORT_S3_PRESIGN_TTL_SECONDS=
# Opt-in local MinIO (make objectstore-up); generated by make bootstrap.
OBJECTSTORE_ROOT_USER=replace_me
OBJECTSTORE_ROOT_PASSWORD=replace_me
OBJECTSTORE_KMS_SECRET_KEY=replace_me
CONTROL_PLANE_URL=http://127.0.0.1:3010
# Stage 09b: secret-store value (at least 32 bytes); enables API-key routes.
CONTROL_API_KEY_PEPPER=
CONTROL_API_KEY_ENV=dev
# Configure the enterprise OAuth client-credentials issuer (Auth0 or local IdP).
CONTROL_M2M_ISSUER=
CONTROL_M2M_AUDIENCE=
CONTROL_M2M_JWKS_URL=
# Tenant claim the IdP mints into each machine client token (ADR-0020); default gg_tenant.
CONTROL_M2M_TENANT_CLAIM=
# Comma-separated https issuers tenants may register machine clients for; default CONTROL_M2M_ISSUER.
MACHINE_ISSUER_ALLOWLIST=
INGEST_KEY_RATE=0.2
INGEST_KEY_BURST=20
# Optional trusted ingress proxy CIDRs for deriving the per-peer bucket key.
# Leave blank for direct-peer mode. Never use 0.0.0.0/0 or ::/0.
INGEST_TRUSTED_PROXY_CIDRS=
AUTH_MEMBERSHIP_SOURCE=file
# Set to the canonical tenant topic broker and reachable Redis Cluster nodes when
# AUTH_MEMBERSHIP_SOURCE=control-plane; keep file mode for the local fixture only.
AUTH_MEMBERSHIP_KAFKA_BROKERS=127.0.0.1:59092
AUTH_MEMBERSHIP_REDIS_CLUSTER_NODES=redis://127.0.0.1:7101,redis://127.0.0.1:7102,redis://127.0.0.1:7103
AUTH_MEMBERSHIP_REDIS_URL=
AUTH_MEMBERSHIP_REDIS_NODE_ADDRESS_MAP=redis-node-1:6379=127.0.0.1:7101,redis-node-2:6379=127.0.0.1:7102,redis-node-3:6379=127.0.0.1:7103,redis-node-4:6379=127.0.0.1:7104,redis-node-5:6379=127.0.0.1:7105,redis-node-6:6379=127.0.0.1:7106
RABBITMQ_PASSWORD=replace_me
RABBITMQ_URL=amqp://greenguard:replace_me@127.0.0.1:55672/
VITE_SENTRY_DSN=
# Opt-in local OIDC (make oidc-up, ADR-0014). Generated by make bootstrap.
OIDC_DEV_PASSWORD=replace_me
# Dashboard OIDC (leave empty to run without sign-in)
VITE_OIDC_AUTHORITY=
VITE_OIDC_CLIENT_ID=
VITE_OIDC_AUDIENCE=
# BFF/Read API optional membership mapping and JWKS tuning
# Risk policy API only: default false requires issuer+subject membership mapping.
# Set true only for explicit local development using signed tenant/role claims.
AUTH_ALLOW_SIGNED_CLAIMS=false
AUTH_MEMBERSHIP_FILE=
# Optional live membership lookup for the jobs-worker notification history API.
# When AUTH_MEMBERSHIP_SOURCE=control-plane, set the HTTPS endpoint and a 32+ byte service token.
CONTROL_PLANE_URL=
CONTROL_LOOKUP_TOKEN=
AUTH_ALLOW_INSECURE_MEMBERSHIP_LOOKUP=false
