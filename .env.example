# bootstrap generates random local credentials in ignored .env; never use these placeholders.
POSTGRES_PASSWORD=replace_me
INVENTORY_DB_PASSWORD=replace_me
TELEMETRY_DB_PASSWORD=replace_me
INVENTORY_DATABASE_URL=postgresql://inventory_app:replace_me@127.0.0.1:55432/greenguard_inventory
TELEMETRY_DATABASE_URL=postgresql://telemetry_app:replace_me@127.0.0.1:55432/greenguard_telemetry
